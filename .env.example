# Copy this file to ".env" and fill it in yourself. Never share .env or paste it in a chat.

# Zernio dashboard -> API keys -> Create API key (starts with sk_)
ZERNIO_API_KEY=paste-your-key-here


# pexels.com/api -> free key for stock video clips
PEXELS_API_KEY=paste-pexels-key-here

# pixabay.com/api/docs -> log in, your free key is shown on that page
PIXABAY_API_KEY=paste-pixabay-key-here

# Telegram alerts: token from @BotFather
TELEGRAM_BOT_TOKEN=paste-telegram-token-here
# your Telegram chat id (same as the other channels): the repository is public, so keep it here and as the
# GitHub Secret TELEGRAM_CHAT_ID rather than in config.json
TELEGRAM_CHAT_ID=paste-your-chat-id-here
